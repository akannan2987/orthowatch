# ── Data ─────────────────────────────────────────────────────────────
# Data files are regenerated by scripts (see docs/), so they stay out of
# Git. This keeps the repo small and proves the pipeline is reproducible.
data/raw/
data/processed/

# ── R ────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
# renv stores the actual package files here; the renv.lock file (which
# IS committed) is enough for anyone to reinstall identical packages.
renv/library/
renv/staging/
renv/local/
renv/cellar/

# ── Python ───────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ── Quarto / rendered output ────────────────────────────────────────
report/*.html
report/*_files/
/.quarto/

# ── Operating system noise ──────────────────────────────────────────
.DS_Store
Thumbs.db
.Ruserdata

 Interactive chart previews # 
# figures/*.html are throwaway previews, regenerated on every run 
# committing ~4 MB of embedded chart library per run would bloat Git's
# permanent history. The PUBLISHED copy lives in docs/interactive/
# (committed deliberately, served by GitHub  see Phase 3, 4.8c).Pages 
figures/*.html
figures/*_files/
